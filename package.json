{
  "name": "cat-skills",
  "version": "1.2.3",
  "private": true,
  "description": "Cat Skills: a solo vibe-coding workflow built on Matt Pocock's agent skills",
  "repository": {
    "type": "git",
    "url": "https://github.com/awangs1986/popcodeskills"
  },
  "license": "MIT",
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-plugin-version.mjs",
    "check-plugin-version": "node scripts/sync-plugin-version.mjs --check",
    "check-skills": "node scripts/check-skills.mjs",
    "sync-conversation-style": "node scripts/sync-conversation-style.mjs",
    "check-conversation-style": "node scripts/sync-conversation-style.mjs --check",
    "test": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0",
    "linkedom": "^0.18.13"
  },
  "packageManager": "npm@10.9.4"
}
